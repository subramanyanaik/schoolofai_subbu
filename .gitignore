# Session 6: regenerable intermediates.
# `work/` holds tokenized shards and per-phase summaries; run_demo.py rebuilds
# it from corpus/ and tokenizer/, both of which ARE committed.
assignment6/work/

# Checkpoint weight blobs are ~10MB each and are regenerated by run_demo.py.
# The binding RECORDS (checkpoints/*.json) are committed, because they carry
# the ledger offset, ledger head hash, loader state and record hash that the
# evidence bundle verifies -- those are the graded artefact, not the tensors.
assignment6/submission_artifacts/checkpoints/*.pt

# Assignment 7: regenerable inputs and weights.
# data/ holds the tokenized FineWeb-Edu bins (~120 MB) and the Wikipedia OOD
# text; both are rebuilt by experiments/prepare_data.py and
# experiments/build_ood_corpus.py.  checkpoints/ holds the five trained arms
# (~50 MB each), rebuilt by experiments/e4_train_arms.py.  results/ and
# figures/ ARE committed -- every number in the README is read from them.
assignment7/data/
assignment7/checkpoints/

# Assignment 9: the corpus the notebook downloads on first run.
# results/results.json, the two figures and run_log.txt ARE committed -- every
# number in the README is rendered from that JSON, and CI checks it.
assignment9/results/tinyshakespeare.txt
assignment9/results/notebook_exec.log

# Assignment 10: the corpus the notebook downloads on first run, and the
# nbclient transcript.  results/results.json, the six figures, run_log.txt,
# shapes_full.txt and step_log.npz ARE committed -- every number in the README
# is rendered from that JSON, and CI checks it.
assignment10/results/tinyshakespeare.txt
assignment10/results/nbexec.log
